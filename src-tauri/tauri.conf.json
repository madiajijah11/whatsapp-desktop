{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhatsApp Desktop",
  "version": "1.0.0",
  "identifier": "com.genzodr.whatsapp-desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WhatsApp",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "url": "https://web.whatsapp.com"
      }
    ],
    "security": {
      "csp": "default-src 'self' https://web.whatsapp.com https://*.whatsapp.com https://*.whatsapp.net https://*.facebook.com https://*.fbcdn.net https://*.fb.com 'unsafe-inline' 'unsafe-eval' blob: data: ws: wss:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
